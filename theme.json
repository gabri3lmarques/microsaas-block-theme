{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Microsaas",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1240px"
    },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#4F46E5",
          "name": "Primary (Indigo)"
        },
        {
          "slug": "primary-dark",
          "color": "#3730A3",
          "name": "Primary Dark"
        },
        {
          "slug": "primary-light",
          "color": "#EEF2FF",
          "name": "Primary Light"
        },
        {
          "slug": "secondary",
          "color": "#06B6D4",
          "name": "Secondary (Cyan)"
        },
        {
          "slug": "secondary-dark",
          "color": "#0891B2",
          "name": "Secondary Dark"
        },
        {
          "slug": "accent",
          "color": "#F59E0B",
          "name": "Accent (Amber)"
        },
        {
          "slug": "dark",
          "color": "#0F172A",
          "name": "Dark (Slate 900)"
        },
        {
          "slug": "dark-muted",
          "color": "#475569",
          "name": "Dark Muted (Slate 600)"
        },
        {
          "slug": "light",
          "color": "#FFFFFF",
          "name": "Light (White)"
        },
        {
          "slug": "surface",
          "color": "#F8FAFC",
          "name": "Surface (Slate 50)"
        },
        {
          "slug": "surface-alt",
          "color": "#F1F5F9",
          "name": "Surface Alt (Slate 100)"
        },
        {
          "slug": "border",
          "color": "#E2E8F0",
          "name": "Border (Slate 200)"
        },
        {
          "slug": "success",
          "color": "#10B981",
          "name": "Success (Emerald)"
        },
        {
          "slug": "error",
          "color": "#EF4444",
          "name": "Error (Red)"
        }
      ],
      "gradients": [
        {
          "slug": "primary-to-secondary",
          "gradient": "linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%)",
          "name": "Indigo to Cyan"
        },
        {
          "slug": "dark-glow",
          "gradient": "linear-gradient(180deg, #0F172A 0%, #1E293B 100%)",
          "name": "Dark Slate Gradient"
        },
        {
          "slug": "subtle-light",
          "gradient": "linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%)",
          "name": "Subtle Light Gradient"
        },
        {
          "slug": "hero-radial",
          "gradient": "radial-gradient(circle at 50% 0%, rgba(79, 70, 229, 0.12) 0%, rgba(255, 255, 255, 0) 70%)",
          "name": "Hero Glow Radial"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "slug": "inter",
          "name": "Inter / Sans Modern"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', Inter, -apple-system, BlinkMacSystemFont, sans-serif",
          "slug": "heading",
          "name": "Plus Jakarta Sans"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "slug": "monospace",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem",
          "fluid": {
            "min": "0.8125rem",
            "max": "0.875rem"
          }
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem",
          "fluid": {
            "min": "0.9375rem",
            "max": "1.0625rem"
          }
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.375rem"
          }
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "1.75rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        },
        {
          "name": "2X Large",
          "slug": "2x-large",
          "size": "2.25rem",
          "fluid": {
            "min": "1.875rem",
            "max": "2.75rem"
          }
        },
        {
          "name": "3X Large",
          "slug": "3x-large",
          "size": "3rem",
          "fluid": {
            "min": "2.25rem",
            "max": "3.5rem"
          }
        },
        {
          "name": "4X Large",
          "slug": "4x-large",
          "size": "3.75rem",
          "fluid": {
            "min": "2.75rem",
            "max": "4.5rem"
          }
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        {
          "name": "1 - Extra Small (8px)",
          "size": "0.5rem",
          "slug": "20"
        },
        {
          "name": "2 - Small (16px)",
          "size": "1rem",
          "slug": "30"
        },
        {
          "name": "3 - Medium (24px)",
          "size": "1.5rem",
          "slug": "40"
        },
        {
          "name": "4 - Large (32px)",
          "size": "2rem",
          "slug": "50"
        },
        {
          "name": "5 - Extra Large (48px)",
          "size": "3rem",
          "slug": "60"
        },
        {
          "name": "6 - 2X Large (64px)",
          "size": "4rem",
          "slug": "70"
        },
        {
          "name": "7 - 3X Large (96px)",
          "size": "6rem",
          "slug": "80"
        }
      ]
    },
    "shadow": {
      "defaultPresets": true,
      "presets": [
        {
          "name": "SaaS Card",
          "slug": "saas-card",
          "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05)"
        },
        {
          "name": "SaaS Elevated",
          "slug": "saas-elevated",
          "shadow": "0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04)"
        },
        {
          "name": "SaaS Glow",
          "slug": "saas-glow",
          "shadow": "0 20px 35px -10px rgba(79, 70, 229, 0.25)"
        }
      ]
    },
    "dimensions": {
      "minHeight": true,
      "aspectRatio": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--light)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "1.5rem",
        "bottom": "0px",
        "left": "1.5rem"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "letterSpacing": "-0.025em",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--dark)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4x-large)",
          "fontWeight": "800",
          "letterSpacing": "-0.035em",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3x-large)",
          "fontWeight": "700",
          "letterSpacing": "-0.03em",
          "lineHeight": "1.15"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2x-large)",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "600"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600",
          "textTransform": "uppercase",
          "letterSpacing": "0.05em"
        }
      },
      "button": {
        "border": {
          "radius": "8px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--light)"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--medium)"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontWeight": "500",
          "fontSize": "0.9375rem"
        },
        "color": {
          "text": "var(--wp--preset--color--dark-muted)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        },
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--60)",
            "bottom": "var(--wp--preset--spacing--60)"
          }
        }
      }
    }
  }
}
