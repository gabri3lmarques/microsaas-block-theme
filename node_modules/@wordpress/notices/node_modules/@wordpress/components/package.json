			"import": "./build-module/index.mjs",
			"require": "./build/index.cjs"
		},
		"./README.md": "./README.md",
		"./CONTRIBUTING.md": "./CONTRIBUTING.md",
		"./package.json": "./package.json",
		"./build-style/*": "./build-style/*"
	},
	"wpScript": true,
	"types": "build-types",
	"sideEffects": [
		"build-style/**",
		"src/**/*.scss"
	],
